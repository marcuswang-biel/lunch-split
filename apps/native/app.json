{
	"expo": {
		"name": "午飯拼單",
		"slug": "lunch-split",
		"version": "0.1.0",
		"scheme": "lunch-split",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.lunchsplit.app"
		},
		"android": {
			"package": "com.lunchsplit.app"
		},
		"plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
